DATABASE_URL=postgresql://localhost:5432/pubky_pulse
JWT_SECRET=dev-secret-change-me
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
# Believe X-Forwarded-For (set to true only when a proxy terminates in front of the API)
TRUST_PROXY=false
MAX_DATABASE_SIZE_GB=0
RESEND_API_KEY=
EMAIL_FROM=noreply@pulse.pubky.org
COOKIE_DOMAIN=

# ── Identity: allowed domains and the singleton team ─────────────────────────
# All four are REQUIRED in every environment, including local development and
# tests. There are no built-in defaults: an invalid or missing value fails
# server startup with an error naming the variable. The placeholders below are
# neutral examples — replace all four with your own values.
#
# Comma-separated list of email domains allowed to sign in. Matching is EXACT
# and case-insensitive: with only "example.com" listed, user@sub.example.com and
# user@notexample.com are both rejected — list a subdomain separately to allow
# it. Empty entries (a trailing comma), malformed domains and duplicates after
# normalization are rejected.
PULSE_ALLOWED_EMAIL_DOMAINS=example.com
# Display name of the one team every allowed user joins. Non-empty, max 255 chars.
PULSE_DEFAULT_TEAM_NAME=Example Team
# Stable identifier of that team. Lowercase letters, numbers and hyphens only.
PULSE_DEFAULT_TEAM_SLUG=example-team
# The sole team owner and recovery identity. Exactly one address, normalized
# to lowercase, whose domain must appear in PULSE_ALLOWED_EMAIL_DOMAINS. This
# person is the team's only `owner`; everybody else joins as `member`.
PULSE_TEAM_OWNER_EMAIL=owner@example.com
#
# On startup the server finds or creates the team with this slug and name, and
# fails if a second active team exists. `pnpm dev:seed` inserts its own team
# ("Default Team" / `default`, owned by `admin@pulse.pubky.org`), so a local
# stack that seeds must point the four variables above at that team and domain
# instead of the placeholders — otherwise the bootstrap sees two active teams
# and refuses to start.

# Base URL of the web dashboard. Used for the links in notification emails.
WEB_APP_URL=http://localhost:3000
# Public base URL of this API server, as reached from browsers and SDKs. It is
# baked into the attachment upload/download URLs handed out to clients, so a
# self-hosted instance must set it — the built-in fallback is a placeholder host
# (https://api.pulse.pubky.org) that you do not control.
API_PUBLIC_URL=http://localhost:4000
# If set, every system job run emails a completion/failure alert here.
SYSTEM_JOBS_ALERT_EMAIL=

# Event attachments (SDK file uploads for debugging failed events).
# Directory where file bytes are stored. Defaults to ./data/attachments in dev
# and /opt/pubky-pulse-attachments in prod. Exclude from pg_dump backups.
PULSE_ATTACHMENTS_PATH=
# HMAC secret for signed download URLs. REQUIRED in production — server will refuse
# to start without it. Generate with `openssl rand -hex 32`. Must NOT equal JWT_SECRET.
# In dev this falls back to JWT_SECRET for convenience.
PULSE_ATTACHMENTS_SIGNING_SECRET=
# If nginx is configured with an `internal` location mapped to PULSE_ATTACHMENTS_PATH,
# set this to that URI prefix (e.g. "/_attachments/") and the server will send
# X-Accel-Redirect instead of streaming bytes through Node. Leave empty in dev.
PULSE_ATTACHMENTS_INTERNAL_URI=

# ── Web dashboard ────────────────────────────────────────────────────────────
# The Next.js dashboard reads exactly one variable, NEXT_PUBLIC_API_URL — the
# base URL of the API server as reached from the *browser*. It does NOT belong
# in this file: Next.js resolves .env files relative to apps/web, and the value
# is inlined into the client bundle at build time. Put it in apps/web/.env
# (gitignored) before running `pnpm build`, and rebuild after changing it:
#
#   echo 'NEXT_PUBLIC_API_URL=https://api.yourdomain.com' > apps/web/.env
#
# Unset, the dashboard falls back to http://localhost:4000, which is correct for
# local development and wrong for every deployment.
