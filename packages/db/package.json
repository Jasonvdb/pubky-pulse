{
  "name": "@pubky-pulse/db",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "tsx scripts/generate.ts",
    "check": "drizzle-kit check && tsx scripts/generate.ts ci_drift_check --check",
    "migrate": "tsx src/migrate.ts",
    "dev:seed": "tsx src/seed.ts",
    "dev:seed-events": "tsx src/seed-events.ts",
    "dev:seed-issues": "tsx src/seed-issues.ts",
    "dev:seed-aggregates": "tsx src/seed-aggregates.ts",
    "dev:seed-locale-users": "tsx src/seed-locale-users.ts",
    "dev:seed-user-variations": "tsx src/seed-user-variations.ts",
    "dev:backfill-locale": "tsx src/backfill-last-locale.ts",
    "dev:unsafe-reset": "tsx src/clear.ts",
    "cleanup": "tsx src/cleanup.ts",
    "cleanup-stranded-anons": "tsx src/cleanup-stranded-anons.ts"
  },
  "dependencies": {
    "@pubky-pulse/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
